rules_version = '2';

// Setlister ligger under spaces/{hash}/setlists/{id}, der {hash} er SHA-256 av koden
// brukerne logger inn med. Den som kjenner koden, kan lese og skrive setlistene for den.
// Det er ikke mulig å liste opp alle spaces, så koden fungerer som et passord.
service cloud.firestore {
  match /databases/{database}/documents {
    match /spaces/{space}/setlists/{setlistId} {
      allow get, list, delete: if space.matches('^[0-9a-f]{64}$');
      allow create, update: if space.matches('^[0-9a-f]{64}$')
        && request.resource.data.id == setlistId
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500;
    }
  }
}
